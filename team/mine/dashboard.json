      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r.thingId =~ /^org\\.openegiz\\.pit:truck-/ and r._field =~ /^value_(state|assigned_excavator)_properties_value$/)\n  |> last()\n  |> map(fn: (r) => ({thingId: r.thingId, _value: r._value, _field: strings.trimSuffix(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), suffix: \"_properties_value\")}))\n  |> group(columns: [\"thingId\"])\n  |> pivot(rowKey: [\"thingId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r.thingId =~ /^org\\.openegiz\\.pit:truck-/ and r._field =~ /^value_(payload_t|speed_kmh|fuel_pct|trips_total)_properties_value$/)\n  |> last()\n  |> map(fn: (r) => ({thingId: r.thingId, _value: r._value, _field: strings.trimSuffix(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), suffix: \"_properties_value\")}))\n  |> group(columns: [\"thingId\"])\n  |> pivot(rowKey: [\"thingId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "thingId",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "thingId": 0,
              "state": 1,
              "assigned_excavator": 2,
              "payload_t": 3,
              "speed_kmh": 4,
              "fuel_pct": 5,
              "trips_total": 6
            },
            "renameByName": {
              "thingId": "twin",
              "payload_t": "payload, t",
              "speed_kmh": "speed, km/h",
              "fuel_pct": "fuel, %",
              "trips_total": "trips"
            }
