worker_processes 1;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;

  server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
      try_files $uri $uri/ =404;
    }

    # Same-origin proxy to Ditto with the real credentials injected here,
    # server-side -- the browser never sees DITTO_PASSWORD. Also what makes
    # EventSource (SSE) work at all: it cannot set a custom Authorization
    # header, so without this proxy the browser could not authenticate to
    # ditto-nginx's own auth_basic directly. See team/mine/README.md.
    location /ditto/ {
      proxy_pass http://ditto-nginx:80/;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Authorization "Basic ${DITTO_AUTH_BASE64}";
      # SSE must not be buffered, and buffering off is harmless for the
      # plain REST calls (bootstrap fetch, scenario PUTs) on the same path.
      proxy_buffering off;
      proxy_cache off;
      chunked_transfer_encoding off;
      proxy_read_timeout 1d;
      proxy_send_timeout 1d;
    }
  }
}
